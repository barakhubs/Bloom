# Copy to .env and adjust. Real environment variables override this file.

# local | production
APP_ENV=local
# Optional: force error display on/off (defaults to on unless APP_ENV=production)
# APP_DEBUG=false

# Public base URL - used for emailed links, Stripe success/cancel URLs, canonical/OG tags
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bloom
DB_USERNAME=root
DB_PASSWORD=

# Fallback sender identity (live SMTP settings are managed in Admin -> Settings)
MAIL_FROM_EMAIL=no-reply@bloombeyondborders.org
MAIL_FROM_NAME="Bloom Beyond Borders"

# Stripe (optional). When set, these override the keys saved in Admin -> Settings -> Payments.
# Use sk_test_... / the `stripe listen` whsec_... locally, live keys in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
